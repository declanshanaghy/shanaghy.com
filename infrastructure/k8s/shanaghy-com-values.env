# Pack orchestration values for shanaghy.com — sourced by
# infrastructure/k8s/agents/dispatch-job.sh (auto-discovered: *-values.env).
# PACK_IMAGE is the FULL image path WITHOUT a tag — job-template.yaml
# appends :{{IMAGE_TAG}} itself. Never put a tag in PACK_IMAGE.
